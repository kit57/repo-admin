###############################################################################################################################
# LLM Provider
###############################################################################################################################
# One of: ollama | anthropic | openai   (aliases: gemma -> ollama, claude -> anthropic)
# Defaults to ollama, an open-weight model running locally — no API key and no per-token cost.
LLM_PROVIDER="ollama"
# Optional — comma-separated providers to try if the main one fails before responding, e.g. "anthropic"
LLM_FALLBACK_PROVIDERS=""
# Optional — max response tokens for every provider, defaults to 8000
LLM_MAX_TOKENS=

###############################################################################################################################
# Ollama (open-weight models: Gemma, Llama, Qwen...)
###############################################################################################################################
# Optional — defaults to http://localhost:11434 (Docker Compose points this at its own ollama service)
OLLAMA_BASE_URL=""
# Optional — defaults to gemma3:4b. Pull it first with: ollama pull gemma3:4b
OLLAMA_MODEL=""
# Optional — context window in tokens, defaults to 32768. Larger = more repo context, more RAM.
OLLAMA_NUM_CTX=
# Optional — layers to run on the GPU; set to 0 to force CPU (e.g. no GPU, or GPU driver errors)
OLLAMA_NUM_GPU=

###############################################################################################################################
# Claude API Configuration (only needed when LLM_PROVIDER=anthropic)
###############################################################################################################################
ANTHROPIC_API_KEY=""
# Optional — defaults to claude-sonnet-5-5 and LLM_MAX_TOKENS
CLAUDE_MODEL=""
CLAUDE_MAX_TOKENS=

###############################################################################################################################
# OpenAI or any OpenAI-compatible API (only needed when LLM_PROVIDER=openai)
###############################################################################################################################
OPENAI_API_KEY=""
# Required for this provider — the model name to use
OPENAI_MODEL=""
# Optional — defaults to https://api.openai.com/v1. Set it for OpenRouter, Groq, vLLM, LM Studio, etc.
OPENAI_BASE_URL=""

###############################################################################################################################
# LLM usage & cost tracing (every call is always stored in the SQLite DB)
###############################################################################################################################
# Optional — print one JSON line per LLM call to stdout, defaults to true
LLM_USAGE_LOG=
# Optional — JSON file adding/overriding prices (USD per 1M tokens), e.g.
# {"openai/gpt-x": {"input": 1.25, "output": 10, "cache_read": 0.125}}
LLM_PRICING_FILE=""
# Optional — export spans + metrics over OTLP/HTTP (needs: pip install -r requirements-otel.txt)
# e.g. http://localhost:4318 for a local OpenTelemetry Collector or Datadog Agent
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_SERVICE_NAME="repo-admin-backend"


###############################################################################################################################
# Github API Configuration
###############################################################################################################################
# Personal access token — required to list your repos. Classic PAT with "repo" scope,
# or a fine-grained token with read access to Metadata, Contents, Issues and Pull requests.
GITHUB_TOKEN=""

###############################################################################################################################
# Storage
###############################################################################################################################
# Optional — defaults to backend/repo_admin.db
DB_PATH=""
